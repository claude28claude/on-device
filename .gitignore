# Test files generated by scripts/make-samples.mjs.
# They are large, they are reproducible with one command, and they are not
# part of the published site.
# Note: the contents are ignored, not the folder itself. Git cannot re-include
# a file that sits inside an ignored DIRECTORY, so the exception below only
# works because the pattern is "samples/*" rather than "samples/".
samples/*

# ...except this one. It is a real JPEG produced by a browser, which Node
# cannot recreate without an image library, and scripts/add-exif.mjs needs it.
!samples/photo-plain.jpg

node_modules/
.DS_Store
Thumbs.db
